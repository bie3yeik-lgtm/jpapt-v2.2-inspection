# Local-only RTF preflight/provider adapter inputs.
# Never commit real values. GitHub Actions uses Repository Secrets instead.
HF_TOKEN=
RUNPOD_TOKEN=
# RUNPOD_API is accepted as a local compatibility alias, but RUNPOD_TOKEN is canonical.
RUNPOD_API=
# RunPod registry auth ID for private GHCR pulls (do not put the password here).
RUNPOD_REGISTRY_AUTH_ID=
RTF_RUNPOD_REQUIRE_REGISTRY_AUTH=1
RTF_IMAGE_DIGEST=sha256:<64-hex-digest>
RTF_RUN_ID=local-rtf-smoke
RTF_MODEL_ID=nvidia/parakeet-tdt_ctc-0.6b-ja
RTF_MODEL_REVISION=<40-hex-model-commit>
RTF_DATASET_ID=japanese-asr/ja_asr.common_voice_8_0
RTF_DATASET_REVISION=<40-hex-dataset-commit>
RTF_FIXTURE_REPO_ID=gawohok7/rtf-benchmark-fixtures
RTF_FIXTURE_REVISION=<40-hex-fixture-commit>
RTF_FIXTURE_MANIFEST_SHA256=<64-hex-manifest-sha256>
RTF_GPU=t4
