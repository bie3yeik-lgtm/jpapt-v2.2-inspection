{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jpapt:nemo-reference-quality:v1",
  "title": "NeMo Reference ASR Quality Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_run_id", "source", "decoder", "normalization", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "reference_run_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision_resolved", "model_file", "model_file_sha256", "library", "language", "license"],
      "properties": {
        "repo_id": {"const": "nvidia/parakeet-tdt_ctc-0.6b-ja"},
        "revision_resolved": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "model_file": {"const": "parakeet-tdt_ctc-0.6b-ja.nemo"},
        "model_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "library": {"const": "nemo"},
        "language": {"const": "ja"},
        "license": {"const": "cc-by-4.0"}
      }
    },
    "decoder": {"enum": ["ctc", "tdt"]},
    "normalization": {"const": "asr_metrics_v1"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audio_sha256", "reference_text", "text", "normalized_text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reference_text": {"type": "string"},
          "text": {"type": "string"},
          "normalized_text": {"type": "string"}
        }
      }
    }
  }
}
