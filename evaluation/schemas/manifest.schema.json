{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/manifest.schema.json",
  "title": "ASR Evaluation Manifest Entry",
  "description": "Minimal human-authored dataset selection instruction. Stable-hash selection, entry identity and derived metadata are implementation details.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "count", "seed"],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "min_duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "max_duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
