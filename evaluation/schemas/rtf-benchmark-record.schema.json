{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/rtf-benchmark-record.schema.json",
  "title": "RTF benchmark record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "phase", "service_id", "gpu", "model_id", "decoder", "dataset_manifest_id", "dataset_manifest_sha256", "dataset_revision", "image_digest", "batch_size", "repeat", "precision", "status", "provider_execution_proof", "audio_duration_sec", "processing_duration_sec", "rtf", "rtfx", "rtf_scope", "cer", "wer", "peak_vram_mb", "gpu_utilization_percent", "gpu_price_per_hour", "cost_per_audio_hour", "metrics_uri", "metrics_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "run_id": {"type": "string", "minLength": 1}, "phase": {"type": "string", "enum": ["phase1", "full"]},
    "service_id": {"type": "string", "enum": ["hf-inference-endpoint", "hf-jobs", "runpod-pod"]}, "gpu": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}, "decoder": {"type": "string", "enum": ["tdt", "ctc", "whisper"]},
    "dataset_manifest_id": {"type": "string", "minLength": 1}, "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"}, "dataset_revision": {"type": "string", "minLength": 1}, "image_digest": {"type": "string", "minLength": 8},
    "batch_size": {"type": "integer", "minimum": 1}, "repeat": {"type": "integer", "minimum": 1}, "precision": {"type": "string", "enum": ["float32", "float16", "bfloat16"]}, "status": {"type": "string", "enum": ["completed", "failed", "blocked", "not_verified"]}, "provider_execution_proof": {"type": "boolean"},
    "audio_duration_sec": {"type": "number", "exclusiveMinimum": 0}, "processing_duration_sec": {"type": "number", "exclusiveMinimum": 0}, "rtf": {"type": "number", "exclusiveMinimum": 0}, "rtfx": {"type": "number", "exclusiveMinimum": 0}, "rtf_scope": {"type": "string", "enum": ["model", "service"]},
    "cer": {"type": ["number", "null"], "minimum": 0}, "wer": {"type": ["number", "null"], "minimum": 0}, "peak_vram_mb": {"type": ["number", "null"], "minimum": 0}, "gpu_utilization_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "gpu_price_per_hour": {"type": ["number", "null"], "minimum": 0}, "cost_per_audio_hour": {"type": ["number", "null"], "minimum": 0},
    "metrics_uri": {"type": "string", "minLength": 1}, "metrics_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}
}
