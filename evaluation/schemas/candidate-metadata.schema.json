{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/candidate-metadata.schema.json",
  "title": "ASR ONNX Candidate Metadata",
  "description": "Minimal human-authored candidate layout. Generated identity, hashes, sizes, catalog fingerprints, tensor bindings and decoder configuration are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_set", "variants"],
  "properties": {
    "profile_set": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokenizer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
