{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/rtf-service-metrics.schema.json",
  "title": "RTF service benchmark metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "model_id", "model_revision", "dataset_id", "dataset_revision", "manifest_sha256", "image_digest", "inspection_profile", "fixture_repo_id", "fixture_revision", "decoder", "audio_duration_sec", "processing_duration_sec", "rtf", "rtfx", "rtf_scope", "provider", "environment", "service_id", "gpu", "dtype", "batch_size", "repeat", "cer", "peak_vram_bytes", "gpu_utilization_pct", "gpu_price_per_hour", "cost_per_audio_hour"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed"]},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_revision": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "image_digest": {"type": "string", "minLength": 8},
    "inspection_profile": {"type": "string", "enum": ["smoke", "pref", "probe"]},
    "fixture_repo_id": {"type": "string", "const": "gawohok7/rtf-benchmark-fixtures"},
    "fixture_revision": {"type": "string", "minLength": 40, "maxLength": 40},
    "decoder": {"type": "string", "enum": ["tdt", "ctc", "whisper"]},
    "precision": {"type": "string", "enum": ["float32", "float16", "bfloat16"]},
    "audio_duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "processing_duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "rtf": {"type": "number", "exclusiveMinimum": 0},
    "rtfx": {"type": "number", "exclusiveMinimum": 0},
    "rtf_scope": {"type": "string", "enum": ["model", "service"]},
    "provider": {"type": "string", "enum": ["cpu", "cuda", "directml", "coreml"]},
    "environment": {"type": "string", "enum": ["linux", "windows", "macos"]},
    "service_id": {"type": "string", "enum": ["hf-inference-endpoint", "hf-jobs", "runpod-pod", "runpod-serverless"]},
    "gpu": {"type": ["string", "null"]},
    "dtype": {"type": "string", "enum": ["float32", "float16", "bfloat16"]},
    "batch_size": {"type": "integer", "minimum": 1},
    "repeat": {"type": "integer", "minimum": 1},
    "cer": {"type": ["number", "null"], "minimum": 0},
    "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
    "gpu_utilization_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "gpu_price_per_hour": {"type": ["number", "null"], "minimum": 0},
    "cost_per_audio_hour": {"type": ["number", "null"], "minimum": 0},
    "provider_job": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "job_id", "url", "namespace", "flavor", "billing_duration_sec", "billed_minutes", "unit_cost_usd_per_minute", "job_cost_usd", "cost_basis"],
          "properties": {
            "provider": {"const": "hf-jobs"},
            "job_id": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"},
            "namespace": {"type": "string", "minLength": 1},
            "flavor": {"type": "string", "minLength": 1},
            "billing_duration_sec": {"type": "number", "exclusiveMinimum": 0},
            "billed_minutes": {"type": "integer", "minimum": 1},
            "unit_cost_usd_per_minute": {"type": "number", "exclusiveMinimum": 0},
            "job_cost_usd": {"type": "number", "exclusiveMinimum": 0},
            "cost_basis": {"const": "hf_jobs_billed_starting_running_minutes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "job_id", "url", "gpu_type_id", "billing_duration_sec", "billed_seconds", "job_cost_usd", "cost_basis"],
          "properties": {
            "provider": {"const": "runpod-pod"},
            "job_id": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"},
            "gpu_type_id": {"type": "string", "minLength": 1},
            "billing_duration_sec": {"type": "number", "exclusiveMinimum": 0},
            "billed_seconds": {"type": "integer", "minimum": 1},
            "job_cost_usd": {"type": "number", "exclusiveMinimum": 0},
            "cost_basis": {"const": "runpod_billing_history"}
          }
        }
      ]
    }
  }
}
