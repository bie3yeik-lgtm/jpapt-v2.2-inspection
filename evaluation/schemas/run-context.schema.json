{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/run-context.schema.json",
  "title": "ASR ONNX Run Context",
  "description": "Immutable strict execution context. Schema v2 rejects unknown or nullable execution identities and keeps reusable runtime semantics in the pinned ASR runtime catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "config_identity",
    "model_id",
    "environment_id",
    "provider_id",
    "evaluation_id",
    "artifact",
    "git",
    "host",
    "runtime",
    "revisions",
    "config",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "config_identity": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "enum": ["linux", "windows", "macos"]},
    "provider_id": {"type": "string", "enum": ["cpu", "cuda", "directml", "coreml"]},
    "evaluation_id": {"type": "string", "enum": ["smoke", "parity", "coreml-parity", "full"]},
    "artifact": {"$ref": "#/$defs/artifactIdentity"},
    "git": {"$ref": "#/$defs/gitIdentity"},
    "host": {"$ref": "#/$defs/hostIdentity"},
    "runtime": {"$ref": "#/$defs/runtimeIdentity"},
    "revisions": {"$ref": "#/$defs/revisionBundle"},
    "config": {"$ref": "#/$defs/resolvedConfiguration"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "repoRevisionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision"],
      "properties": {
        "repo_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "catalogReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_sha256", "catalog", "profile_set"],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "catalog": {"$ref": "#/$defs/catalogReference"},
        "profile_set": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "candidate_id", "artifact_role"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "artifact_role": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "ref", "dirty"],
      "properties": {
        "repository": {"$ref": "#/$defs/nonEmptyString"},
        "commit": {"type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$"},
        "ref": {"$ref": "#/$defs/nonEmptyString"},
        "dirty": {"type": "boolean"}
      }
    },
    "hostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "hostname",
        "python_version",
        "implementation",
        "is_wsl",
        "github_runner_os",
        "github_runner_arch",
        "github_run_id",
        "github_run_attempt"
      ],
      "properties": {
        "os": {"$ref": "#/$defs/nonEmptyString"},
        "architecture": {"$ref": "#/$defs/nonEmptyString"},
        "hostname": {"$ref": "#/$defs/nonEmptyString"},
        "python_version": {"$ref": "#/$defs/nonEmptyString"},
        "implementation": {"$ref": "#/$defs/nonEmptyString"},
        "is_wsl": {"type": "boolean"},
        "github_runner_os": {"$ref": "#/$defs/nonEmptyString"},
        "github_runner_arch": {"$ref": "#/$defs/nonEmptyString"},
        "github_run_id": {"$ref": "#/$defs/nonEmptyString"},
        "github_run_attempt": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "backend",
        "backend_version",
        "provider_id",
        "provider_ort_name",
        "provider_available"
      ],
      "properties": {
        "implementation": {"type": "string", "enum": ["python", "rust"]},
        "backend": {"type": "string", "const": "onnxruntime"},
        "backend_version": {"$ref": "#/$defs/nonEmptyString"},
        "provider_id": {"type": "string", "enum": ["cpu", "cuda", "directml", "coreml"]},
        "provider_ort_name": {"$ref": "#/$defs/nonEmptyString"},
        "provider_available": {"type": "boolean"}
      }
    },
    "revisionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_version",
        "bundle_sha256",
        "runtime",
        "reference",
        "evaluation_schema",
        "datasets"
      ],
      "properties": {
        "config_version": {"type": "string", "pattern": "^config-[0-9]{6}$"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "runtime": {"$ref": "#/$defs/runtimeRevision"},
        "reference": {"$ref": "#/$defs/referenceRevision"},
        "evaluation_schema": {"$ref": "#/$defs/evaluationSchemaRevision"},
        "datasets": {"$ref": "#/$defs/datasetsRevision"}
      }
    },
    "referenceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "development_artifact",
        "upstream",
        "tokenizer",
        "reference_id",
        "reference_revision",
        "canonical_framework"
      ],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "development_artifact": {"$ref": "#/$defs/repoRevisionIdentity"},
        "upstream": {"$ref": "#/$defs/repoRevisionIdentity"},
        "tokenizer": {"$ref": "#/$defs/repoRevisionIdentity"},
        "reference_id": {"$ref": "#/$defs/nonEmptyString"},
        "reference_revision": {"$ref": "#/$defs/nonEmptyString"},
        "canonical_framework": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "evaluationSchemaRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_sha256", "schema_id", "schema_revision"],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "schema_id": {"$ref": "#/$defs/nonEmptyString"},
        "schema_revision": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "datasetsRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_sha256", "entries"],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/datasetRevisionEntry"}}
      }
    },
    "datasetRevisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo_id", "revision", "subset", "split", "sha256", "manifest"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "repo_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"$ref": "#/$defs/nonEmptyString"},
        "subset": {"$ref": "#/$defs/nonEmptyString"},
        "split": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "resolvedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "sources", "resolved"],
      "properties": {
        "identity": {"$ref": "#/$defs/nonEmptyString"},
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "provider", "environment", "evaluation"],
          "properties": {
            "model": {"$ref": "#/$defs/nonEmptyString"},
            "provider": {"$ref": "#/$defs/nonEmptyString"},
            "environment": {"$ref": "#/$defs/nonEmptyString"},
            "evaluation": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "resolved": {
          "type": "object",
          "required": ["model", "provider", "environment", "evaluation", "resolved"],
          "properties": {
            "model": {"type": "object"},
            "provider": {"type": "object"},
            "environment": {"type": "object"},
            "evaluation": {"type": "object"},
            "resolved": {
              "type": "object",
              "required": ["model_id", "provider_id", "environment_id", "evaluation_id"],
              "properties": {
                "model_id": {"$ref": "#/$defs/nonEmptyString"},
                "provider_id": {"$ref": "#/$defs/nonEmptyString"},
                "environment_id": {"$ref": "#/$defs/nonEmptyString"},
                "evaluation_id": {"$ref": "#/$defs/nonEmptyString"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
