{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/run-context.schema.json",
  "title": "ASR ONNX Run Context",
  "description": "Immutable execution context. Schema v2 normalizes runtime/profile semantics under revisions.runtime; schema v1 remains readable for historical runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "config_identity",
    "model_id",
    "environment_id",
    "provider_id",
    "evaluation_id",
    "artifact",
    "git",
    "host",
    "runtime",
    "revisions",
    "config",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "config_identity": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "enum": ["linux", "windows", "macos"]},
    "provider_id": {"type": "string", "enum": ["cpu", "cuda", "directml", "coreml"]},
    "evaluation_id": {"type": "string", "enum": ["smoke", "parity", "coreml-parity", "full"]},
    "artifact": {"$ref": "#/$defs/artifactIdentity"},
    "git": {"$ref": "#/$defs/gitIdentity"},
    "host": {"$ref": "#/$defs/hostIdentity"},
    "runtime": {"$ref": "#/$defs/runtimeIdentity"},
    "revisions": {"$ref": "#/$defs/revisionBundle"},
    "config": {"$ref": "#/$defs/resolvedConfiguration"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "repoRevisionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "decoderRevisionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "default"],
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "default": {"type": "string", "minLength": 1}
      }
    },
    "catalogReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeRevision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["document_sha256", "catalog", "profile_set"],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "catalog": {"$ref": "#/$defs/catalogReference"},
        "profile_set": {"type": "string", "minLength": 1},
        "variants": {"type": "object", "additionalProperties": {"type": "string"}},
        "default_variant": {"type": "string", "minLength": 1},
        "decoders": {"$ref": "#/$defs/decoderRevisionSet"}
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "candidate_id", "artifact_role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/nullableString"},
        "artifact_role": {"$ref": "#/$defs/nullableString"}
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "ref", "dirty"],
      "properties": {
        "repository": {"$ref": "#/$defs/nullableString"},
        "commit": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{7,64}$"},
        "ref": {"$ref": "#/$defs/nullableString"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "hostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "hostname",
        "python_version",
        "implementation",
        "is_wsl",
        "github_runner_os",
        "github_runner_arch",
        "github_run_id",
        "github_run_attempt"
      ],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "hostname": {"$ref": "#/$defs/nullableString"},
        "python_version": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "is_wsl": {"type": "boolean"},
        "github_runner_os": {"$ref": "#/$defs/nullableString"},
        "github_runner_arch": {"$ref": "#/$defs/nullableString"},
        "github_run_id": {"$ref": "#/$defs/nullableString"},
        "github_run_attempt": {"$ref": "#/$defs/nullableString"}
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "backend",
        "backend_version",
        "provider_id",
        "provider_ort_name",
        "provider_available"
      ],
      "properties": {
        "implementation": {"type": "string", "enum": ["python", "rust"]},
        "backend": {"type": "string", "enum": ["onnxruntime", "nemo", "transformers"]},
        "backend_version": {"$ref": "#/$defs/nullableString"},
        "provider_id": {"type": "string", "enum": ["cpu", "cuda", "directml", "coreml"]},
        "provider_ort_name": {"type": "string", "minLength": 1},
        "provider_available": {"type": ["boolean", "null"]}
      }
    },
    "revisionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_version", "bundle_sha256", "reference", "evaluation_schema", "datasets"],
      "properties": {
        "config_version": {"type": ["string", "null"], "pattern": "^config-[0-9]{6}$"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "runtime": {"$ref": "#/$defs/runtimeRevision"},
        "reference": {"$ref": "#/$defs/referenceRevision"},
        "evaluation_schema": {"$ref": "#/$defs/evaluationSchemaRevision"},
        "datasets": {"$ref": "#/$defs/datasetsRevision"}
      }
    },
    "referenceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "development_artifact",
        "upstream",
        "tokenizer",
        "reference_id",
        "reference_revision",
        "canonical_framework"
      ],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "development_artifact": {"$ref": "#/$defs/repoRevisionIdentity"},
        "upstream": {"$ref": "#/$defs/repoRevisionIdentity"},
        "tokenizer": {"$ref": "#/$defs/repoRevisionIdentity"},
        "reference_id": {"type": "string", "minLength": 1},
        "reference_revision": {"type": "string", "minLength": 1},
        "canonical_framework": {"type": "string", "minLength": 1},
        "decoders": {"$ref": "#/$defs/decoderRevisionSet"}
      }
    },
    "evaluationSchemaRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_sha256", "schema_id", "schema_revision"],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "schema_id": {"type": "string", "minLength": 1},
        "schema_revision": {"type": "string", "minLength": 1},
        "decoders": {"$ref": "#/$defs/decoderRevisionSet"}
      }
    },
    "datasetsRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_sha256", "entries"],
      "properties": {
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/datasetRevisionEntry"}}
      }
    },
    "datasetRevisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo_id", "revision", "subset", "split", "sha256", "manifest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repo_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "subset": {"$ref": "#/$defs/nullableString"},
        "split": {"$ref": "#/$defs/nullableString"},
        "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "manifest": {"$ref": "#/$defs/nullableString"}
      }
    },
    "resolvedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "sources", "resolved"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "provider", "environment", "evaluation"],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "environment": {"type": "string", "minLength": 1},
            "evaluation": {"type": "string", "minLength": 1}
          }
        },
        "resolved": {
          "type": "object",
          "required": ["model", "provider", "environment", "evaluation", "resolved"],
          "properties": {
            "model": {"type": "object"},
            "provider": {"type": "object"},
            "environment": {"type": "object"},
            "evaluation": {"type": "object"},
            "resolved": {
              "type": "object",
              "required": ["model_id", "provider_id", "environment_id", "evaluation_id"],
              "properties": {
                "model_id": {"type": "string"},
                "provider_id": {"type": "string"},
                "environment_id": {"type": "string"},
                "evaluation_id": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
