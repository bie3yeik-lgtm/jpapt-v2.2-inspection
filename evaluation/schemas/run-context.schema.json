{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parakeet-onnx.local/schemas/run-context.schema.json",
  "title": "Parakeet ONNX Run Context",
  "description": "Immutable execution context identifying the model artifact, Git state, host, runtime, provider, configuration, and Hugging Face revision locks used for one evaluation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "config_identity",
    "model_id",
    "environment_id",
    "provider_id",
    "evaluation_id",
    "artifact",
    "git",
    "host",
    "runtime",
    "revisions",
    "config",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "config_identity": {
      "type": "string",
      "minLength": 1,
      "description": "Resolved model:environment:provider:evaluation identity."
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "environment_id": {
      "type": "string",
      "enum": [
        "linux",
        "windows",
        "macos"
      ]
    },
    "provider_id": {
      "type": "string",
      "enum": [
        "cpu",
        "cuda",
        "directml",
        "coreml"
      ]
    },
    "evaluation_id": {
      "type": "string",
      "enum": [
        "smoke",
        "parity",
        "full"
      ]
    },
    "artifact": {
      "$ref": "#/$defs/artifactIdentity"
    },
    "git": {
      "$ref": "#/$defs/gitIdentity"
    },
    "host": {
      "$ref": "#/$defs/hostIdentity"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeIdentity"
    },
    "revisions": {
      "$ref": "#/$defs/revisionBundle"
    },
    "config": {
      "$ref": "#/$defs/resolvedConfiguration"
    },
    "metadata": {
      "type": "object",
      "description": "Optional project-specific metadata not required for core run identity.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "candidate_id",
        "artifact_role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/nullableString"
        },
        "artifact_role": {
          "$ref": "#/$defs/nullableString",
          "description": "Logical role such as ctc, encoder, predictor, joint, or baseline."
        }
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "ref",
        "dirty"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nullableString"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{7,64}$"
        },
        "ref": {
          "$ref": "#/$defs/nullableString"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "hostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "hostname",
        "python_version",
        "implementation",
        "is_wsl",
        "github_runner_os",
        "github_runner_arch",
        "github_run_id",
        "github_run_attempt"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "$ref": "#/$defs/nullableString"
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "is_wsl": {
          "type": "boolean"
        },
        "github_runner_os": {
          "$ref": "#/$defs/nullableString"
        },
        "github_runner_arch": {
          "$ref": "#/$defs/nullableString"
        },
        "github_run_id": {
          "$ref": "#/$defs/nullableString"
        },
        "github_run_attempt": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "backend",
        "backend_version",
        "provider_id",
        "provider_ort_name",
        "provider_available"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "enum": [
            "python",
            "rust"
          ]
        },
        "backend": {
          "type": "string",
          "enum": [
            "onnxruntime",
            "nemo",
            "transformers"
          ]
        },
        "backend_version": {
          "$ref": "#/$defs/nullableString"
        },
        "provider_id": {
          "type": "string",
          "enum": [
            "cpu",
            "cuda",
            "directml",
            "coreml"
          ]
        },
        "provider_ort_name": {
          "type": "string",
          "minLength": 1
        },
        "provider_available": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "revisionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_sha256",
        "reference",
        "evaluation_schema",
        "datasets"
      ],
      "properties": {
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference": {
          "$ref": "#/$defs/referenceRevision"
        },
        "evaluation_schema": {
          "$ref": "#/$defs/evaluationSchemaRevision"
        },
        "datasets": {
          "$ref": "#/$defs/datasetsRevision"
        }
      }
    },
    "referenceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "model_id",
        "model_revision",
        "reference_id",
        "reference_revision",
        "tokenizer_revision"
      ],
      "properties": {
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "reference_id": {
          "$ref": "#/$defs/nullableString"
        },
        "reference_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "tokenizer_revision": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "evaluationSchemaRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "schema_id",
        "schema_revision"
      ],
      "properties": {
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "datasetsRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "entries"
      ],
      "properties": {
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/datasetRevisionEntry"
          }
        }
      }
    },
    "datasetRevisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repo_id",
        "revision",
        "subset",
        "split",
        "sha256",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "subset": {
          "$ref": "#/$defs/nullableString"
        },
        "split": {
          "$ref": "#/$defs/nullableString"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "manifest": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "resolvedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sources",
        "resolved"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "provider",
            "environment",
            "evaluation"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "evaluation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resolved": {
          "type": "object",
          "description": "Namespaced configuration snapshot produced by ResolvedConfig.",
          "required": [
            "model",
            "provider",
            "environment",
            "evaluation",
            "resolved"
          ],
          "properties": {
            "model": {
              "type": "object"
            },
            "provider": {
              "type": "object"
            },
            "environment": {
              "type": "object"
            },
            "evaluation": {
              "type": "object"
            },
            "resolved": {
              "type": "object",
              "required": [
                "model_id",
                "provider_id",
                "environment_id",
                "evaluation_id"
              ],
              "properties": {
                "model_id": {
                  "type": "string"
                },
                "provider_id": {
                  "type": "string"
                },
                "environment_id": {
                  "type": "string"
                },
                "evaluation_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
